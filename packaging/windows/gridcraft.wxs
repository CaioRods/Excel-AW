<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="ExcelAW" Manufacturer="Caio Victor Rodrigues" Version="$(var.Version)" UpgradeCode="5511327B-F305-41BE-92D0-EB84944E7C4D" Scope="perUserOrMachine" Compressed="yes" Language="1046">
    <SummaryInformation Description="Planilhas ExcelAW" Manufacturer="Caio Victor Rodrigues" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Uma versão mais recente do ExcelAW já está instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="GridcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="GridcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/CaioRods/Excel-AW" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/CaioRods/Excel-AW" />
    <Property Id="ARPHELPLINK" Value="https://github.com/CaioRods/Excel-AW/issues" />

    <!-- An explicit command-line value wins. Otherwise retain the previous installation's
         choice, defaulting to off for a fresh install. Run only in the first sequence so the
         execute sequence cannot reload the old choice after the user unchecks the box. -->
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />
    <Property Id="SAVEDDESKTOPSHORTCUT" Secure="yes">
      </Property>
    <SetProperty Id="DESKTOPSHORTCUT" Action="LoadDesktopShortcutPreference" Value="1" After="CraftLoadOption1U" Sequence="first" Condition="NOT DESKTOPSHORTCUT AND SAVEDDESKTOPSHORTCUT = &quot;1&quot;" />
    <SetProperty Id="DESKTOPSHORTCUT" Action="DefaultDesktopShortcut" Value="0" After="LoadDesktopShortcutPreference" Sequence="first" Condition="NOT DESKTOPSHORTCUT" />
    <SetProperty Id="DesktopShortcutChoice" Value="1" After="DefaultDesktopShortcut" Sequence="ui" Condition="DESKTOPSHORTCUT = &quot;1&quot;" />

    <Property Id="DefaultUIFont" Value="GridcraftUIFont" />
    <Property Id="ErrorDialog" Value="GridcraftErrorDlg" />
    <EnsureTable Id="ListBox" />
    <UI>
      <TextStyle Id="GridcraftUIFont" FaceName="Segoe UI" Size="9" />
      <Dialog Id="DesktopShortcutDlg" Width="320" Height="150" Title="Instalação do ExcelAW" NoMinimize="yes">
        <Control Id="Heading" Type="Text" X="15" Y="15" Width="290" Height="20" Text="Instalar ExcelAW" />
        <Control Id="Description" Type="Text" X="15" Y="40" Width="290" Height="28" Text="Instale o ExcelAW com a opção de conta selecionada." />
        <Control Id="DesktopShortcutCheckbox" Type="CheckBox" X="15" Y="76" Width="290" Height="18" Property="DesktopShortcutChoice" CheckBoxValue="1" Text="Criar atalho na área de &amp;trabalho" />
        <Control Id="Install" Type="PushButton" X="165" Y="118" Width="65" Height="20" Default="yes" DefaultCondition="ALLUSERS = 1" ElevationShield="yes" HideCondition="ALLUSERS &lt;&gt; 1" ShowCondition="ALLUSERS = 1" Text="&amp;Instalar">
          <!-- An unchecked checkbox clears its property. Publish an explicit zero so the
               elevated execute sequence receives an unambiguous opt-out. -->
          <Publish Property="DESKTOPSHORTCUT" Value="1" Condition="DesktopShortcutChoice" />
          <Publish Property="DESKTOPSHORTCUT" Value="0" Condition="NOT DesktopShortcutChoice" />
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="InstallUser" Type="PushButton" DefaultCondition="ALLUSERS &lt;&gt; 1" HideCondition="ALLUSERS = 1" ShowCondition="ALLUSERS &lt;&gt; 1" X="165" Y="118" Width="65" Height="20" Text="&amp;Instalar">
          <!-- An unchecked checkbox clears its property. Publish an explicit zero so the
               elevated execute sequence receives an unambiguous opt-out. -->
          <Publish Property="DESKTOPSHORTCUT" Value="1" Condition="DesktopShortcutChoice" />
          <Publish Property="DESKTOPSHORTCUT" Value="0" Condition="NOT DesktopShortcutChoice" />
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="240" Y="118" Width="65" Height="20" Cancel="yes" Text="Cancelar">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- Windows Installer requires these support dialogs for authored full UI (ICE20).
           They contain only installer messages and standard response controls. -->
      <Dialog Id="GridcraftErrorDlg" Width="320" Height="120" Title="Instalação do ExcelAW" ErrorDialog="yes" NoMinimize="yes">
        <Control Id="ErrorText" Type="Text" X="15" Y="15" Width="290" Height="65" TabSkip="no" />
        <Control Id="A" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Interromper" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorAbort" />
        </Control>
        <Control Id="C" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Cancelar" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorCancel" />
        </Control>
        <Control Id="I" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Ignorar" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorIgnore" />
        </Control>
        <Control Id="N" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Não" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorNo" />
        </Control>
        <Control Id="O" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="OK" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorOk" />
        </Control>
        <Control Id="R" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Repetir" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorRetry" />
        </Control>
        <Control Id="Y" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Sim" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorYes" />
        </Control>
      </Dialog>
      <Dialog Id="FilesInUse" Width="320" Height="190" Title="Instalação do ExcelAW" NoMinimize="yes">
        <Control Id="Description" Type="Text" X="15" Y="15" Width="290" Height="35" Text="Feche os aplicativos abaixo e clique em Repetir. Ignorar pode exigir uma reinicialização." />
        <Control Id="Files" Type="ListBox" X="15" Y="55" Width="290" Height="85" Property="FileInUseProcess" />
        <Control Id="Retry" Type="PushButton" X="95" Y="155" Width="65" Height="20" Default="yes" Text="Repetir">
          <Publish Event="EndDialog" Value="Retry" />
        </Control>
        <Control Id="Ignore" Type="PushButton" X="167" Y="155" Width="65" Height="20" Text="Ignorar">
          <Publish Event="EndDialog" Value="Ignore" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="240" Y="155" Width="65" Height="20" Cancel="yes" Text="Cancelar">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <Dialog Id="SetupCompleteDlg" Width="320" Height="110" Title="Instalação do ExcelAW" NoMinimize="yes">
        <Control Id="Message" Type="Text" X="15" Y="20" Width="290" Height="35" Text="Instalação do ExcelAW concluída." />
        <Control Id="Close" Type="PushButton" X="240" Y="75" Width="65" Height="20" Default="yes" Cancel="yes" Text="Fechar">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
      <Dialog Id="SetupCanceledDlg" Width="320" Height="110" Title="Instalação do ExcelAW" NoMinimize="yes">
        <Control Id="Message" Type="Text" X="15" Y="20" Width="290" Height="35" Text="Instalação do ExcelAW cancelada." />
        <Control Id="Close" Type="PushButton" X="240" Y="75" Width="65" Height="20" Default="yes" Cancel="yes" Text="Fechar">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
      <Dialog Id="SetupFailedDlg" Width="320" Height="110" Title="Instalação do ExcelAW" NoMinimize="yes">
        <Control Id="Message" Type="Text" X="15" Y="20" Width="290" Height="35" Text="Não foi possível concluir a instalação do ExcelAW. Consulte a mensagem ou o registro do instalador." />
        <Control Id="Close" Type="PushButton" X="240" Y="75" Width="65" Height="20" Default="yes" Cancel="yes" Text="Fechar">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
    </UI>
    <InstallUISequence>
      <!-- Component conditions must see the choice before costing. Do not show the choice
           during basic/silent installs, repair or uninstall. -->
      <Show Dialog="DesktopShortcutDlg" Before="CostInitialize" Condition="NOT Installed AND NOT REMOVE AND UILevel = 5" />
      <Show Dialog="SetupCompleteDlg" OnExit="success" Condition="UILevel = 5" />
      <Show Dialog="SetupCanceledDlg" OnExit="cancel" Condition="UILevel = 5" />
      <Show Dialog="SetupFailedDlg" OnExit="error" Condition="UILevel = 5" />
    </InstallUISequence>
    <AdminUISequence>
      <Show Dialog="SetupCompleteDlg" OnExit="success" Condition="UILevel = 5" />
      <Show Dialog="SetupCanceledDlg" OnExit="cancel" Condition="UILevel = 5" />
      <Show Dialog="SetupFailedDlg" OnExit="error" Condition="UILevel = 5" />
    </AdminUISequence>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="ArtCraft">
        <Directory Id="INSTALLFOLDER" Name="ExcelAW" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="ExcelAW" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="GridcraftFiles" />
    </Feature>
  <Property Id="CRAFT_OPTION_1_M" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_1_MSearch" Root="HKLM" Key="Software\ExcelAW\Installer" Name="DesktopShortcut" Type="raw" />
    </Property><SetProperty Id="SAVEDDESKTOPSHORTCUT" Action="CraftLoadOption1M" Value="[CRAFT_OPTION_1_M]" After="LaunchConditions" Sequence="both" Condition="ALLUSERS = 1" /><Property Id="CRAFT_OPTION_1_U" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_1_USearch" Root="HKCU" Key="Software\ExcelAW\Installer" Name="DesktopShortcut" Type="raw" />
    </Property><SetProperty Id="SAVEDDESKTOPSHORTCUT" Action="CraftLoadOption1U" Value="[CRAFT_OPTION_1_U]" After="CraftLoadOption1M" Sequence="both" Condition="ALLUSERS &lt;&gt; 1" /></Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="GridcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="GridcraftApp" Guid="0507D4B6-12FF-4882-84E1-59083E74A4EB">
        <File Id="GridcraftExe" Source="$(var.BinDir)\gridcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="ExcelAW" Description="Planilhas ExcelAW" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="GridcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\gridcraft.exe" Value="[#GridcraftExe]" Type="string" />

        <!-- ProgIds: how Explorer opens a file with ExcelAW. Nothing here sets HKCR\.<ext>'s
             default value, so the user's current default app is left alone. -->
        <RegistryValue Root="HKMU" Key="Software\Classes\ExcelAW.Workbook" Value="Pasta de Trabalho ExcelAW" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\ExcelAW.Workbook\DefaultIcon" Value="&quot;[#GridcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\ExcelAW.Workbook\shell\open\command" Value="&quot;[#GridcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\ExcelAW.TextData" Value="Dados de Texto ExcelAW" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\ExcelAW.TextData\DefaultIcon" Value="&quot;[#GridcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\ExcelAW.TextData\shell\open\command" Value="&quot;[#GridcraftExe]&quot; &quot;%1&quot;" Type="string" />

        <!-- "Open with": Windows reads only the value names under OpenWithProgids; the data is
             ignored (WiX rejects an empty Value, so it repeats the ProgId). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\.xlsx\OpenWithProgids" Name="ExcelAW.Workbook" Value="ExcelAW.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xlsm\OpenWithProgids" Name="ExcelAW.Workbook" Value="ExcelAW.Workbook" Type="string" />
        <!-- .xlsb and .ods are imported (data only) into a new workbook that saves as .xlsx. -->
        <RegistryValue Root="HKMU" Key="Software\Classes\.xlsb\OpenWithProgids" Name="ExcelAW.Workbook" Value="ExcelAW.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ods\OpenWithProgids" Name="ExcelAW.Workbook" Value="ExcelAW.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.csv\OpenWithProgids" Name="ExcelAW.TextData" Value="ExcelAW.TextData" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tsv\OpenWithProgids" Name="ExcelAW.TextData" Value="ExcelAW.TextData" Type="string" />

        <!-- Settings > Default apps: lets the user pick ExcelAW for these types. -->
        <RegistryValue Root="HKMU" Key="Software\ExcelAW\Capabilities" Name="ApplicationName" Value="ExcelAW" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\ExcelAW\Capabilities" Name="ApplicationDescription" Value="Planilha de código aberto para arquivos .xlsx, CSV e TSV" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\ExcelAW\Capabilities\FileAssociations" Name=".xlsx" Value="ExcelAW.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\ExcelAW\Capabilities\FileAssociations" Name=".xlsm" Value="ExcelAW.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\ExcelAW\Capabilities\FileAssociations" Name=".csv" Value="ExcelAW.TextData" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\ExcelAW\Capabilities\FileAssociations" Name=".tsv" Value="ExcelAW.TextData" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="ExcelAW" Value="Software\ExcelAW\Capabilities" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\ExcelAW" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="GridcraftCli">
        <File Id="GridcraftCliExe" Source="$(var.BinDir)\gridcraft-cli.exe" KeyPath="yes" />
      </Component>

      <!-- Persist both on and off, independently of the optional shortcut. AppSearch reads
           this before MajorUpgrade removes the previous product. -->
      <Component Id="DesktopShortcutPreference">
        <RegistryValue Root="HKMU" Key="Software\ExcelAW\Installer" Name="DesktopShortcut" Value="[DESKTOPSHORTCUT]" Type="string" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="ExcelAW" Description="Planilhas ExcelAW" Target="[#GridcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="GridcraftIcon.ico" IconIndex="0" />
        <!-- HKMU resolves to HKLM for this per-machine package, so another account can
             uninstall the marker too. MSI root -1 also satisfies ICE43 for this shortcut. -->
        <RegistryValue Root="HKMU" Key="Software\ExcelAW\Installer" Name="DesktopShortcutComponent" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
